{
  "name": "collaborative_resume_builder",
  "version": "0.1.0",
  "private": true,
  "description": "Collaborative Resume (Contribution) Builder prototype for applicants and employers.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "node server/index.cjs",
    "test": "node --test tests/*.test.*",
    "check": "npm test && npm run build && node --check server/index.cjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
